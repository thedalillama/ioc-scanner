                      "recommended_action":  "Confirm whether Remote Desktop should be enabled on this PC and review network exposure.",
                      "guardrail_reason":  "Remote Desktop enabled",
                      "old_value_pattern":  "Disabled",
                      "path_pattern":  "RemoteDesktop",
