                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "PR.PS / DE.CM",
                      "interpretation":  "Cloud-assisted Defender protection is disabled relative to the trusted baseline.",
                      "recommended_action":  "Review why cloud protection changed and confirm whether this reduction was intended.",
                      "guardrail_reason":  "Defender cloud protection disabled",
                      "new_value_pattern":  "Disabled",
                      "path_pattern":  "DefenderCloudProtection"
                  },
                  {
                      "rule_id":  "guardrail-firewall-disabled",
                      "enabled":  true,
                      "priority":  880,
                      "description":  "Never downgrade disabled firewall profiles.",
