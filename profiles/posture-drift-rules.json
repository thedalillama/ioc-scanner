                  {
                      "rule_id":  "guardrail-tpm-weakened",
                      "enabled":  true,
                      "priority":  845,
                      "description":  "Never downgrade TPM availability weakening.",
                      "rule_type":  "guardrail",
                      "section_pattern":  "SecurityControlBaseline",
                      "item_type_pattern":  "SecurityControl",
                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "PR.PS",
                      "interpretation":  "TPM state is weaker than the trusted baseline and should not be downgraded.",
                      "recommended_action":  "Review whether TPM state changed because of firmware, hardware, or platform configuration drift.",
                      "guardrail_reason":  "TPM became unavailable",
                      "condition_id":  "tpm_weakened",
                      "path_pattern":  "TPM"
                  },
                  {
                      "rule_id":  "guardrail-security-log-unavailable",
                      "enabled":  true,
                      "priority":  840,
                      "description":  "Never downgrade Security log availability loss.",
                      "rule_type":  "guardrail",
                      "section_pattern":  "LoggingAuditBaseline",
                      "item_type_pattern":  "LoggingAudit",
                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "DE.CM / DE.AE",
                      "interpretation":  "The Security event log is no longer available for evidence collection.",
                      "recommended_action":  "Check why the Security event log became unavailable before treating related churn as benign.",
                      "guardrail_reason":  "Security log unavailable",
                      "condition_id":  "log_unavailable_or_disabled",
                      "path_pattern":  "SecurityLog"
                  },
