{
    "schema_version":  1,
    "description":  "Local explainable posture drift rules for Codex tripwire classification.",
    "rules":  [
                  {
                      "rule_id":  "guardrail-defender-exclusion-added",
                      "enabled":  true,
                      "priority":  900,
                      "description":  "Never downgrade newly added Microsoft Defender exclusions.",
                      "rule_type":  "guardrail",
                      "section_pattern":  "SecurityControlBaseline",
                      "item_type_pattern":  "SecurityControl",
                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "PR.PS / DE.CM",
                      "interpretation":  "Microsoft Defender exclusions changed from the trusted baseline. Guardrails keep this security drift at warning severity.",
                      "recommended_action":  "Review the newly added exclusion and confirm it was intentionally approved.",
                      "guardrail_reason":  "Defender exclusion added",
                      "notes_pattern":  "*Added exclusions:*",
                      "path_pattern":  "DefenderExclusions"
                  },
                  {
                      "rule_id":  "guardrail-defender-realtime-disabled",
                      "enabled":  true,
                      "priority":  890,
                      "description":  "Never downgrade disabled Defender real-time protection.",
                      "rule_type":  "guardrail",
                      "section_pattern":  "SecurityControlBaseline",
                      "item_type_pattern":  "SecurityControl",
                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "PR.PS / DE.CM",
                      "interpretation":  "Real-time malware protection is disabled relative to the trusted baseline.",
                      "recommended_action":  "Verify why Defender real-time protection changed and restore the expected posture if appropriate.",
                      "guardrail_reason":  "Defender real-time protection disabled",
                      "new_value_pattern":  "Disabled",
                      "path_pattern":  "DefenderRealTime"
                  },
                  {
                      "rule_id":  "guardrail-defender-cloud-disabled",
                      "enabled":  true,
                      "priority":  885,
                      "description":  "Never downgrade disabled Defender cloud protection.",
