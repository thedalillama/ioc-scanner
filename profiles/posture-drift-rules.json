                      "item_type_pattern":  "SecurityControl",
                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "PR.PS / DE.CM",
                      "interpretation":  "One or more Windows Firewall profiles are now off relative to the trusted baseline.",
                      "recommended_action":  "Check whether the firewall profile change was intentional before treating it as normal churn.",
                      "guardrail_reason":  "Firewall profile disabled",
                      "new_value_pattern":  "*=Off*",
                      "path_pattern":  "FirewallProfiles"
                  },
                  {
                      "rule_id":  "guardrail-uac-weakened",
                      "enabled":  true,
                      "priority":  875,
                      "description":  "Never downgrade weakened UAC posture.",
                      "rule_type":  "guardrail",
                      "section_pattern":  "SecurityControlBaseline",
                      "item_type_pattern":  "SecurityControl",
                      "classification":  "warning",
                      "severity":  "Warning",
                      "csf_mapping":  "PR.PS",
                      "interpretation":  "User Account Control is weaker than the trusted baseline.",
                      "recommended_action":  "Review why UAC changed and confirm whether the weaker posture is approved.",
                      "guardrail_reason":  "UAC weakened",
                      "new_value_pattern":  "*EnableLUA=0*",
